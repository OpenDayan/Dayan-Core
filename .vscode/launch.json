{
  "configurations": [
    {
      "name": "(gdb) Launch",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/${input:testName}/${input:testName}",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Set Disassembly Flavor to Intel",
          "text": "-gdb-set disassembly-flavor intel",
          "ignoreFailures": true
        }
      ]
    },
    {
      "type": "scala",
      "request": "launch",
      "name": "VPUTestTop",
      "mainClass": "rvtng.vpu.VPUTestTop",
      "buildTarget": "file:///root/RVTNG/rvtng/6.6.0",
      "args": [],
      "jvmOptions": [],
      "env": {}
    },
    {
      "type": "scala",
      "request": "launch",
      "name": "RVTNGTestTop",
      "mainClass": "rvtng.top.RVTNGTestTop",
      "buildTarget": "file:///root/RVTNG/rvtng/6.6.0",
      "args": [],
      "jvmOptions": [],
      "env": {}
    }
  ],
  "inputs": [
    {
      "id": "testName",
      "description": "选择希望运行的 RVTNG 测试用例",
      "options": [
        "VDMATestTop",
        "VRVTNGTestTop"
      ],
      "type": "pickString"
    }
  ]
}